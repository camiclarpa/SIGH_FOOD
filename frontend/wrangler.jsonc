{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Debe coincidir EXACTAMENTE con el nombre del Worker en el dashboard.
  "name": "sigh-bocazo",

  // Salida de @opennextjs/cloudflare (no es un entrypoint propio: lo genera el build).
  "main": ".open-next/worker.js",

  // OpenNext exige 2024-09-23 o posterior + nodejs_compat.
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],

  // Assets estáticos modernos (Workers Static Assets).
  // NO usar "site": esa es la API legada de Workers Sites, incompatible con OpenNext.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Hyperdrive: agrupa conexiones a la base PostgreSQL de Neon (config "sighfood-db").
  // Se accede desde las rutas de Next con getCloudflareContext(), NO con un handler fetch(env).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "be704b244ff041d0b3200284bff8c965"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
