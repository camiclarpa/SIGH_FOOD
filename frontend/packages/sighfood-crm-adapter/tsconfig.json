{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    // El paquete se publica como TypeScript (main/types apuntan a index.ts) y
    // lo transpila quien lo consume, así que `build` es solo verificación.
    "noEmit": true,
    // @sighfood/domain se consume como fuente TypeScript, sin `exports` que
    // expongan subrutas: se mapea igual que en el tsconfig de la raíz.
    "baseUrl": ".",
    "paths": {
      "@sighfood/domain": ["../sighfood-domain"],
      "@sighfood/domain/*": ["../sighfood-domain/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
