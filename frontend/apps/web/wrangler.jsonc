{
  "$schema": "../../node_modules/wrangler/config-schema.json",

  // Worker propio del CRM, separado de la landing (sigh-bocazo).
  "name": "sighbocazo-crm",

  // Cuenta: Camiloriverac0@gmail.com's Account
  "account_id": "5e153923b7c5fdd9468c9b184cee5866",

  // Salida de @opennextjs/cloudflare (no es un entrypoint propio: lo genera el build).
  "main": ".open-next/worker.js",

  // OpenNext exige 2024-09-23 o posterior + nodejs_compat.
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],

  // Assets estáticos modernos (Workers Static Assets).
  // NO usar "site": esa es la API legada de Workers Sites, incompatible con OpenNext.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Hyperdrive: agrupa las conexiones a Neon para que el Worker no abra una
  // conexión nueva por isolate. Se reutiliza la configuración existente
  // "sighfood-db", que ya apunta a esta misma base.
  //
  // Se lee con getCloudflareContext() desde las rutas de Next, no con un
  // handler fetch(env). getDb() detecta este binding y prioriza esa vía sobre
  // DATABASE_URL, que solo se usa en local.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "be704b244ff041d0b3200284bff8c965",

      // Marcador de posición, no una credencial. Wrangler lo usa SOLO para
      // emular Hyperdrive en `wrangler dev`; el despliegue real usa el id de
      // arriba y nunca lee esta cadena.
      //
      // Está aquí porque sin ella el despliegue fallaba. `opennextjs-cloudflare
      // deploy` llama a getPlatformProxy() para leer los bindings, y con
      // Hyperdrive declarado wrangler exige una cadena local aunque esté
      // publicando a producción:
      //
      //   UserError: When developing locally, you should use a local Postgres
      //   connection string to emulate Hyperdrive functionality.
      //
      // El comando de despliegue intentaba cubrirlo con
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="$DATABASE_URL",
      // pero esa variable no existe en el entorno de Workers Builds, así que
      // llegaba vacía y wrangler la trataba como ausente. Resolverlo aquí evita
      // depender de una variable del panel y no expone ninguna credencial.
      //
      // Para desarrollo local con `wrangler dev` contra una base real, cambia
      // esto por tu Postgres local — nunca por la cadena de Neon de producción,
      // que este archivo sí está en git.
      "localConnectionString": "postgresql://usuario:contrasena@localhost:5432/sighfood_local"
    }
  ],

  // Respaldo de lectura: la última copia buena de cada consulta del CRM.
  //
  // No es una caché de rendimiento — las consultas van SIEMPRE a Postgres
  // primero, y esto solo se lee cuando la base no responde. Convierte una caída
  // de Neon, que hoy tumba el CRM entero, en un modo degradado donde las
  // pantallas siguen mostrando datos (avisando de que son de hace un rato) y
  // solo fallan las escrituras.
  //
  // KV y no la Cache API: KV se replica entre centros de datos, así que el
  // respaldo escrito por un isolate sirve a todos los demás.
  "kv_namespaces": [
    {
      "binding": "RESPALDO_LECTURA",
      "id": "1172cd68bd264e4e8af1a6aa1dbc5090"
    }
  ],

  // Workers AI: proveedor de embeddings para la búsqueda semántica.
  //
  // Se usa @cf/baai/bge-m3 (1024 dimensiones). Multilingüe a propósito: lo que
  // se indexa —nombres de bares, perfiles sensoriales, descripciones de
  // incidencias— está en español, y los modelos bge-*-en-* son solo inglés.
  //
  // El binding solo existe dentro del Worker. En `next dev` no está, y el
  // servicio cae a la API REST si hay credenciales; si no las hay, lanza en vez
  // de inventarse un vector.
  "ai": {
    "binding": "AI"
  },

  // Rate limiting global de Cloudflare.
  //
  // El contador que había en el middleware vivía en memoria, y cada isolate
  // tiene la suya: con el tráfico repartido entre isolates el límite real era
  // varias veces el configurado. Este binding lo cuenta en el borde, compartido
  // por todos los isolates, sin añadir Redis ni un Durable Object.
  //
  // `period` solo admite 10 o 60 (segundos). El namespace_id es un entero
  // arbitrario que identifica el contador dentro de la cuenta; cambiarlo
  // reinicia las cuentas de todos los visitantes.
  "ratelimits": [
    {
      "name": "LIMITADOR_PUBLICO",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }

  // AUTH_SECRET no se declara aquí: es un secreto y se sube con
  //   npx wrangler secret put AUTH_SECRET
  // Ponerlo en "vars" lo dejaría en texto plano en este archivo.
}
