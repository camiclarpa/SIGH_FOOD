# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Sin barra inicial: así también cubren apps/*/node_modules y packages/*.
# Con `/node_modules` solo se ignoraba el de la raíz, y por eso acabaron
# versionados 444 archivos de build de apps/web/.next.
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# Sin barra inicial para que aplique en cualquier workspace (apps/web/.next).
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
ADMIN_TOKEN_BACKUP.txt
.env.local

# Wrangler
wrangler.toml

# Cloudflare / OpenNext (artefactos de build)
.open-next/
.wrangler/

# Secretos locales de Cloudflare Workers (wrangler)
.dev.vars
.dev.vars.*
