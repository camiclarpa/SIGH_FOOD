only-built-dependencies[]=esbuild
only-built-dependencies[]=@swc/core
only-built-dependencies[]=sharp
only-built-dependencies[]=unrs-resolver
only-built-dependencies[]=workerd
# node_modules plano: evita los symlinks que el empaquetado de OpenNext
# no puede copiar en Windows sin permisos de administrador (EPERM).
node-linker=hoisted
