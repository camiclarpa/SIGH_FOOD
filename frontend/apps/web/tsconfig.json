{
    "compilerOptions":  {
                            "target":  "ES2020",
                            "lib":  [
                                        "ES2020",
                                        "DOM",
                                        "DOM.Iterable"
                                    ],
                            "allowJs":  true,
                            "module":  "ESNext",
                            "moduleResolution":  "bundler",
                            "jsx":  "react-jsx",
                            "strict":  true,
                            "noEmit":  true,
                            "esModuleInterop":  true,
                            "skipLibCheck":  true,
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "incremental":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "plugins":  [
                                            {
                                                "name":  "next"
                                            }
                                        ],
                            "paths":  {
                                          "@sighfood/domain/*":  [
                                                                     "../../packages/sighfood-domain/src/*"
                                                                 ]
                                      }
                        },
    "include":  [
                    "next-env.d.ts",
                    "**/*.ts",
                    "**/*.tsx",
                    ".next/types/**/*.ts",
                    ".next/dev/types/**/*.ts"
                ],
    "exclude":  [
                    "node_modules"
                ]
}