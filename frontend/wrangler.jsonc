{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Debe coincidir EXACTAMENTE con el nombre del Worker en el dashboard.
  "name": "sigh-bocazo",

  // Salida de @opennextjs/cloudflare (no es un entrypoint propio: lo genera el build).
  "main": ".open-next/worker.js",

  // OpenNext exige 2024-09-23 o posterior + nodejs_compat.
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],

  // Assets estáticos modernos (Workers Static Assets).
  // NO usar "site": esa es la API legada de Workers Sites, incompatible con OpenNext.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Sin binding de Hyperdrive a propósito.
  //
  // La landing no habla con PostgreSQL: sus rutas usan Upstash Redis por REST
  // (ver src/clients/messageQueue.ts). El binding estaba declarado pero no se
  // referenciaba desde ningún punto del código, y rompía el despliegue: al
  // detectar un proyecto OpenNext, `wrangler deploy` delega en
  // `opennextjs-cloudflare deploy`, que llama a getPlatformProxy() para leer
  // los bindings y exige una cadena Postgres local con la que emular
  // Hyperdrive. En el CI no existe, así que el deploy moría con
  // "no local hyperdrive connection string".
  //
  // Quien sí necesita Hyperdrive es el CRM, y lo declara en su propio
  // apps/web/wrangler.jsonc.

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
