{
  "compilerOptions": {
    "target": "ES2020",
    // DOM aporta las definiciones de Web Crypto (crypto.subtle, BufferSource)
    // que usa lib/password.ts y que existen tanto en el navegador como en
    // Cloudflare Workers y Node 18+.
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    // El paquete se publica como TypeScript (main/types apuntan a index.ts) y
    // lo transpila quien lo consume, así que `build` es solo verificación.
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
